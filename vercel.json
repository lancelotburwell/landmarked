{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/instagram.ts": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/cesium/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/photos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/instagram?fill=1", "schedule": "0 1 * * *" },
    { "path": "/api/instagram?h=5", "schedule": "0 5 * * *" },
    { "path": "/api/instagram?h=6", "schedule": "0 6 * * *" },
    { "path": "/api/instagram?h=7", "schedule": "0 7 * * *" },
    { "path": "/api/instagram?h=8", "schedule": "0 8 * * *" },
    { "path": "/api/instagram?h=9", "schedule": "0 9 * * *" },
    { "path": "/api/instagram?h=10", "schedule": "0 10 * * *" },
    { "path": "/api/instagram?h=11", "schedule": "0 11 * * *" },
    { "path": "/api/instagram?h=12", "schedule": "0 12 * * *" },
    { "path": "/api/instagram?h=13", "schedule": "0 13 * * *" },
    { "path": "/api/instagram?h=14", "schedule": "0 14 * * *" },
    { "path": "/api/instagram?h=15", "schedule": "0 15 * * *" },
    { "path": "/api/instagram?h=16", "schedule": "0 16 * * *" },
    { "path": "/api/instagram?h=17", "schedule": "0 17 * * *" },
    { "path": "/api/instagram?h=18", "schedule": "0 18 * * *" },
    { "path": "/api/instagram?h=19", "schedule": "0 19 * * *" },
    { "path": "/api/instagram?h=20", "schedule": "0 20 * * *" },
    { "path": "/api/instagram?h=21", "schedule": "0 21 * * *" }
  ]
}
